# Copie para apps/web/.env.local apenas quando for necessário configurar o SDK Web.
# Use valores do projeto fictício/local. Nunca adicione credenciais administrativas.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-clinica-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-clinica-local
VITE_FIREBASE_STORAGE_BUCKET=demo-clinica-local.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATORS=true

# Opcional: endereço base da API de disponibilidade hospedada no Coolify.
# Em produção, configure como variável de build do frontend depois de publicar a API.
# VITE_AVAILABILITY_API_BASE_URL=https://api.example.com
