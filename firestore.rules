rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    match /clientes/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'cliente'
                    && request.resource.data.status == 'ativo'
                    && request.resource.data.keys().hasOnly([
                      'uid', 'nome', 'telefone', 'email', 'role', 'status', 'createdAt', 'preferenciasContato'
                    ]);

      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['nome', 'telefone', 'preferenciasContato', 'updatedAt']);

      allow delete: if false;

      match /historico/{recordId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /pagamentos/{paymentId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /anamneses/{anamnesisId} {
        allow read: if isAdmin() || isOwner(uid);
        allow write: if false;
      }
    }

    // Coleção de serviços da clínica (massagens, duração, valor e imagem)
    match /servicos/{serviceId} {
      // Leitura pública liberada para visualização do catálogo e agendamento
      allow read: if true;
      // Criação, atualização e exclusão restritas à administração autenticada
      allow write: if isSignedIn();
    }

    // Configurações da clínica (intervalo, folgas, percentual do sinal)
    // Leitura liberada para que a interface de agendamento consulte as regras vigentes
    // Escrita bloqueada no client-side para evitar alteração não autorizada de parâmetros de negócio
    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // Profissionais da clínica (dados de exibição, especialidade, folgas e intervalos)
    // Leitura liberada para que clientes selecionem profissionais na agenda
    // Escrita bloqueada no client-side para proteção cadastral
    match /profissionais/{professionalId} {
      allow read: if true;
      allow write: if false;
    }

    // Usuários do sistema (incluindo contas administrativas)
    // Leitura permitida apenas para o titular autenticado; criação administrativa protegida
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Regra de segurança padrão: bloqueia qualquer outro acesso não especificado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
