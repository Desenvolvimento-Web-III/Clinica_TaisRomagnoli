rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasAdminRegistryRecord() {
      let adminPath = /databases/$(database)/documents/admins/$(request.auth.uid);
      return isSignedIn()
        && exists(adminPath)
        && get(adminPath).data.role == 'admin';
    }

    function isAdmin() {
      return isSignedIn() && (
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        hasAdminRegistryRecord()
      );
    }

    function isDocOwner(data) {
      return isSignedIn() && (
        ('clienteId' in data && data.clienteId == request.auth.uid) ||
        ('uid' in data && data.uid == request.auth.uid)
      );
    }

    function isValidAgendaTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidAgendaDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validBloqueio(data, documentId) {
      let camposPermitidos = [
        'id', 'tipo', 'data', 'diaSemana', 'horaInicio', 'horaFim', 'diaInteiro',
        'frequencia', 'dataInicio', 'dataFim', 'motivo', 'profissionalId', 'ativo',
        'criadoPor', 'criadoEm', 'atualizadoEm'
      ];
      let baseValida = data.keys().hasAll([
          'id', 'tipo', 'horaInicio', 'horaFim', 'motivo', 'profissionalId',
          'ativo', 'criadoPor', 'criadoEm'
        ])
        && data.keys().hasOnly(camposPermitidos)
        && data.id == documentId
        && data.profissionalId is string
        && data.ativo == true
        && data.criadoPor is string
        && data.criadoEm is string
        && data.motivo is string
        && data.motivo.size() > 0
        && data.motivo.size() <= 200
        && isValidAgendaTime(data.horaInicio)
        && isValidAgendaTime(data.horaFim);

      return baseValida && (
        (data.tipo == 'unico'
          && data.keys().hasAll(['data', 'diaInteiro'])
          && isValidAgendaDate(data.data)
          && data.diaInteiro is bool
          && (data.diaInteiro == true || data.horaInicio < data.horaFim))
        ||
        (data.tipo == 'recorrente'
          && data.keys().hasAll(['diaSemana', 'frequencia'])
          && data.diaSemana is int
          && data.diaSemana >= 0
          && data.diaSemana <= 6
          && data.horaInicio < data.horaFim
          && data.frequencia in ['semanal', 'quinzenal']
          && (!('dataInicio' in data) || isValidAgendaDate(data.dataInicio))
          && (!('dataFim' in data) || isValidAgendaDate(data.dataFim))
          && (!('dataInicio' in data) || !('dataFim' in data) || data.dataInicio <= data.dataFim))
      );
    }

    function validHorarioFixo(data, documentId) {
      let perfilCliente = /databases/$(database)/documents/clientes/$(data.clienteId);
      let camposPermitidos = [
        'id', 'clienteId', 'clienteNome', 'clienteTelefone', 'clienteEmail', 'servicoId',
        'servicoNome', 'profissionalId', 'diaSemana', 'horaInicio', 'horaFim', 'frequencia',
        'dataInicio', 'dataFim', 'observacoes', 'ativo', 'criadoPor', 'criadoEm', 'atualizadoEm'
      ];
      return data.keys().hasAll([
          'id', 'clienteId', 'clienteNome', 'profissionalId', 'diaSemana', 'horaInicio',
          'horaFim', 'frequencia', 'dataInicio', 'ativo', 'criadoPor', 'criadoEm'
        ])
        && data.keys().hasOnly(camposPermitidos)
        && data.id == documentId
        && data.clienteId is string
        && data.clienteNome is string
        && data.clienteNome.size() > 0
        && exists(perfilCliente)
        && get(perfilCliente).data.nome == data.clienteNome
        && (!('clienteEmail' in data)
          || ('email' in get(perfilCliente).data && get(perfilCliente).data.email == data.clienteEmail))
        && (!('clienteTelefone' in data)
          || ('telefone' in get(perfilCliente).data && get(perfilCliente).data.telefone == data.clienteTelefone))
        && data.profissionalId is string
        && data.diaSemana is int
        && data.diaSemana >= 0
        && data.diaSemana <= 6
        && isValidAgendaTime(data.horaInicio)
        && isValidAgendaTime(data.horaFim)
        && data.horaInicio < data.horaFim
        && data.frequencia in ['semanal', 'quinzenal']
        && isValidAgendaDate(data.dataInicio)
        && (!('dataFim' in data) || isValidAgendaDate(data.dataFim))
        && (!('dataFim' in data) || data.dataInicio <= data.dataFim)
        && (!('observacoes' in data) || (data.observacoes is string && data.observacoes.size() <= 300))
        && data.ativo is bool
        && data.criadoPor is string
        && data.criadoEm is string
        && (!('atualizadoEm' in data) || data.atualizadoEm is string);
    }

    function profileMatchesBooking(data) {
      let profilePath = /databases/$(database)/documents/clientes/$(data.clienteId);
      return exists(profilePath)
        // O caminho já identifica o cliente. O campo uid é legado e pode não existir em perfis antigos.
        && (!('uid' in get(profilePath).data) || get(profilePath).data.uid == data.clienteId)
        && get(profilePath).data.nome == data.clienteNome
        && (('email' in get(profilePath).data && 'clienteEmail' in data
              && get(profilePath).data.email == data.clienteEmail)
            || (!('email' in get(profilePath).data) && !('clienteEmail' in data)))
        && (('telefone' in get(profilePath).data && 'clienteTelefone' in data
              && get(profilePath).data.telefone == data.clienteTelefone)
            || (!('telefone' in get(profilePath).data) && !('clienteTelefone' in data)));
    }

    function serviceMatchesBooking(data) {
      let servicePath = /databases/$(database)/documents/servicos/$(data.servicoId);
      let servicoDoc = get(servicePath).data;
      return exists(servicePath)
        // O catálogo aceita documentos legados sem ativo/active e os interpreta como ativos.
        && (('active' in servicoDoc && servicoDoc.active == true)
            || (!('active' in servicoDoc)
                && (!('ativo' in servicoDoc) || servicoDoc.ativo == true)))
        // Nomes e valores têm formatos legados distintos (número/string e aliases). O cliente já
        // normaliza esses campos pelo mesmo mapper do catálogo; a regra valida existência/atividade.
        && ((!('name' in servicoDoc) && !('nome' in servicoDoc) && !('nome_servico' in servicoDoc))
            || ('name' in servicoDoc && data.servicoNome == servicoDoc.name)
            || ('nome' in servicoDoc && data.servicoNome == servicoDoc.nome)
            || ('nome_servico' in servicoDoc && data.servicoNome == servicoDoc.nome_servico));
    }

    function validBookingCreate(data) {
      return isSignedIn()
        && (isOwner(data.clienteId) || isAdmin())
        && profileMatchesBooking(data)
        && serviceMatchesBooking(data)
        && data.status == 'pendente'
        && data.sinalIsento == (isAdmin() && !isOwner(data.clienteId) && data.sinalIsento)
        && data.origem == (isOwner(data.clienteId) ? 'app_cliente' : 'presencial_admin')
        && data.intervaloAposMinutos == 30
        && data.duracaoMinutos is int
        && data.duracaoMinutos >= 15
        && data.duracaoMinutos <= 360
        && data.valorTotalEmCentavos is int
        && data.valorTotalEmCentavos >= 100
        && data.valorSinalEmCentavos >= 0
        && data.valorSinalEmCentavos <= data.valorTotalEmCentavos
        && data.saldoRestanteEmCentavos == data.valorTotalEmCentavos - data.valorSinalEmCentavos
        && (!data.sinalIsento || data.valorSinalEmCentavos == 0)
        && data.metodoPagamento in ['pix', 'cartao', 'boleto', 'dinheiro', 'presencial']
        && data.keys().hasAll([
          'id', 'clienteId', 'clienteNome', 'servicoId', 'servicoNome', 'duracaoMinutos',
          'valorTotalEmCentavos', 'valorSinalEmCentavos', 'saldoRestanteEmCentavos',
          'dataHoraInicio', 'dataHoraFim', 'intervaloAposMinutos', 'profissionalId',
          'profissionalNome', 'status', 'metodoPagamento', 'origem', 'sinalIsento',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'clienteId', 'clienteNome', 'clienteEmail', 'clienteTelefone', 'servicoId',
          'servicoNome', 'duracaoMinutos', 'valorTotalEmCentavos', 'valorSinalEmCentavos',
          'saldoRestanteEmCentavos', 'dataHoraInicio', 'dataHoraFim', 'intervaloAposMinutos',
          'profissionalId', 'profissionalNome', 'status', 'metodoPagamento', 'origem',
          'sinalIsento', 'observacoes', 'createdAt', 'updatedAt'
        ]);
    }

    // Coleção de clientes cadastrados
    match /clientes/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'cliente'
                    && request.resource.data.status == 'ativo'
                    && request.resource.data.keys().hasOnly([
                      'uid', 'nome', 'telefone', 'email', 'role', 'status', 'createdAt', 'preferenciasContato'
                    ]);

      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['nome', 'telefone', 'preferenciasContato', 'updatedAt']);

      allow delete: if false;

      match /historico/{recordId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /pagamentos/{paymentId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // Ficha de avaliação (Anamnese) vinculada ao cliente
      match /anamneses/{anamnesisId} {
        allow read: if isAdmin() || isOwner(uid);
        allow write: if false;
      }

      // Agendamentos na subcoleção do cliente
      match /agendamentos/{agendamentoId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid) || isAdmin();
        allow delete: if isAdmin();
      }
    match /notificacoes/{notifId} {
  allow read: if isOwner(uid) || isAdmin();
  allow update: if (isOwner(uid) || isAdmin())
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['lida', 'updatedAt']);
  allow create, delete: if false;
  }
}
    // Coleção raiz de agendamentos
    match /agendamentos/{agendamentoId} {
      allow get: if isAdmin() || isDocOwner(resource.data);
      allow list: if isAdmin() || (isSignedIn() && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.uid == request.auth.uid
      ));
      allow create: if validBookingCreate(request.resource.data)
        && request.resource.data.id == agendamentoId;
      }

    function hasNoRestrictedAnamneseFieldsOnCreate(data) {
      return !(
        'exigeLiberacaoMedica' in data ||
        'contraindicacoes' in data ||
        'motivosLiberacaoMedica' in data ||
        'liberacaoMedicaAprovada' in data ||
        'liberacaoMedicaObservacoes' in data ||
        'liberacaoMedicaAprovadaEm' in data ||
        'liberacaoMedicaAprovadaPor' in data
      );
    }

    function doesNotModifyRestrictedAnamneseFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'exigeLiberacaoMedica',
        'contraindicacoes',
        'motivosLiberacaoMedica',
        'liberacaoMedicaAprovada',
        'liberacaoMedicaObservacoes',
        'liberacaoMedicaAprovadaEm',
        'liberacaoMedicaAprovadaPor'
      ]);
    }

    // Coleções raiz de anamneses e fichas de avaliação
    match /anamneses/{anamnesisId} {
      allow get: if isAdmin() || isOwner(anamnesisId) || isDocOwner(resource.data);
      allow list: if isAdmin() || (isSignedIn() && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.uid == request.auth.uid
      ));
      allow create: if isAdmin() || (
        isDocOwner(request.resource.data) &&
        hasNoRestrictedAnamneseFieldsOnCreate(request.resource.data)
      );
      allow update: if isAdmin() || (
        isDocOwner(resource.data) &&
        isDocOwner(request.resource.data) &&
        doesNotModifyRestrictedAnamneseFields()
      );
      allow delete: if isAdmin();
    }

    match /fichas/{fichaId} {
      allow get: if isAdmin() || isOwner(fichaId) || isDocOwner(resource.data);
      allow list: if isAdmin() || (isSignedIn() && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.uid == request.auth.uid
      ));
      allow create: if isAdmin() || (
        isDocOwner(request.resource.data) &&
        hasNoRestrictedAnamneseFieldsOnCreate(request.resource.data)
      );
      allow update: if isAdmin() || (
        isDocOwner(resource.data) &&
        isDocOwner(request.resource.data) &&
        doesNotModifyRestrictedAnamneseFields()
      );
      allow delete: if isAdmin();
    }

    // Coleção de serviços da clínica (massagens, duração, valor e imagem)
    match /servicos/{serviceId} {
      // Leitura pública liberada para visualização do catálogo e agendamento
      allow read: if true;
      // Criação, atualização e exclusão restritas à administração autenticada
    allow write: if isSignedIn();
    }

    // Configurações da clínica (intervalo, folgas, percentual do sinal)
    // Leitura liberada para que a interface de agendamento consulte as regras vigentes
    // Escrita restrita à administração com custom claim admin
    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.admin == true);
    }

    // Profissionais da clínica (dados de exibição, especialidade, folgas e intervalos)
    // Leitura liberada para que clientes selecionem profissionais na agenda
    // Escrita bloqueada no client-side para proteção cadastral
    match /profissionais/{professionalId} {
      allow read: if true;
      allow write: if false;
    }

    // Usuários do sistema (incluindo contas administrativas)
    // Leitura permitida apenas para o titular autenticado; criação administrativa protegida
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Agendamentos de serviços da clínica
    // Leitura permitida para a administradora ou para o próprio cliente titular do agendamento
    // Criação direta limitada a solicitações pendentes e validadas contra perfil e serviço.
    match /agendamentos/{agendamentoId} {
      allow read: if isAdmin() || isDocOwner(resource.data);
      allow create: if validBookingCreate(request.resource.data)
        && request.resource.data.id == agendamentoId;
      allow update, delete: if false;
    }

    // Bloqueios de agenda da clínica (únicos e recorrentes)
    // A leitura é pública para cálculo de disponibilidade; gravações são validadas e restritas a admins.
    match /bloqueios_agenda/{bloqueioId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.criadoPor == request.auth.uid
        && validBloqueio(request.resource.data, bloqueioId);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo', 'atualizadoEm'])
        && request.resource.data.ativo is bool
        && (!('atualizadoEm' in request.resource.data) || request.resource.data.atualizadoEm is string);
      allow delete: if isAdmin();
    }

    // Horários fixos de clientes da clínica (reservas semanais e quinzenais)
    // Leitura pelo cliente titular ou admin; gravações e gestão são restritas a admins e validadas.
    match /horarios_fixos/{horarioFixoId} {
      allow read: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin()
        && request.resource.data.criadoPor == request.auth.uid
        && validHorarioFixo(request.resource.data, horarioFixoId);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'diaSemana', 'horaInicio', 'horaFim', 'frequencia', 'servicoId', 'servicoNome',
          'dataInicio', 'dataFim', 'observacoes', 'ativo', 'atualizadoEm'
        ])
        && request.resource.data.clienteId == resource.data.clienteId
        && request.resource.data.clienteNome == resource.data.clienteNome
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm
        && validHorarioFixo(request.resource.data, horarioFixoId);
      allow delete: if isAdmin();
    }

    // Trilha de auditoria das operações do sistema
    // Leitura restrita à administração (requer claim de admin)
    // Escrita bloqueada no client-side: registros gerados exclusivamente por Cloud Functions no backend
    match /auditoria/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Regra de segurança padrão: bloqueia qualquer outro acesso não especificado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
