rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de segurança para a coleção clientes
    // Permite leitura e escrita somente se o usuário estiver autenticado e for o dono do registro
    match /clientes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Regra de segurança padrão: bloqueia qualquer outro acesso não especificado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
