rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    match /clientes/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'cliente'
                    && request.resource.data.status == 'ativo'
                    && request.resource.data.keys().hasOnly([
                      'uid', 'nome', 'telefone', 'email', 'role', 'status', 'createdAt'
                    ]);

      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['nome', 'telefone', 'updatedAt']);

      allow delete: if false;

      match /historico/{recordId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /pagamentos/{paymentId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /anamneses/{anamnesisId} {
        allow read: if isAdmin() || isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
