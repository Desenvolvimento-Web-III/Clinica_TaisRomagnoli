{
  "name": "clinica-tais-romagnoli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fundação técnica do projeto web da clínica.",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "functions",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev -w @clinica/web",
    "emulators": "firebase emulators:start --project demo-clinica-local",
    "dev:full": "concurrently --kill-others --names web,emulators \"npm:dev:web\" \"npm:emulators\"",
    "build": "npm run build -w @clinica/shared && npm run build:web && npm run build:functions",
    "build:web": "npm run build -w @clinica/web",
    "build:functions": "npm run build -w @clinica/functions",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run build -w @clinica/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:rules:unit": "vitest run --config vitest.rules.config.ts",
    "test:rules": "firebase emulators:exec --project demo-clinica-local --only firestore \"npm run test:rules:unit\"",
    "test:e2e": "npm run test:e2e -w @clinica/web",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:rules && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "firebase-tools": "^15.28.2",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
